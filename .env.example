# Copy to .env — every value is optional.
# murmur runs with none of these set: local transcription, local classifier,
# and Grok Bot credentials are read from ~/.grokbot/ automatically.

# --- Sharper classification (pick one) ---------------------------------------
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Which of the above to use when more than one is present.
# MURMUR_PROVIDER=groq

# --- Where requests go -------------------------------------------------------
# MURMUR_SINK=grokbot          # or: webhook
# MURMUR_WEBHOOK_URL=https://example.com/hook
# MURMUR_WEBHOOK_TOKEN=        # sent as: Authorization: Bearer <token>

# --- Behaviour ---------------------------------------------------------------
# MURMUR_NOTES_DIR=~/Documents/voice-notes    # unset = notes are discarded
# MURMUR_ASR=local                            # or: groq, openai
# MURMUR_CLASSIFIER=auto                      # or: llm, heuristic
# MURMUR_PREFIX=[from voice memo]<space>
# MURMUR_MEMOS_DIR=                           # override auto-detection

# --- Model pinning (hosted model names get retired) --------------------------
# MURMUR_CHAT_MODEL=
# MURMUR_ASR_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# MURMUR_ASR_REMOTE_MODEL=
