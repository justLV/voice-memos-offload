# Copy to .env — every value is optional except the webhook settings below,
# which the default sink needs. Transcription and classification run locally
# with nothing set.

# --- Sharper classification (pick one) ---------------------------------------
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Auto-detects which of the above you set. Only needed to force one
# when several keys are present (otherwise it prefers groq, then openai, gemini).
# MURMUR_PROVIDER=groq

# --- Where requests go -------------------------------------------------------
# Default sink is `cursor`: it wakes a Grok Bot routine through Cursor's
# automation webhook. Create a routine in the Grok Bot desktop app, add a
# webhook trigger, then copy the POST URL and sender key off the trigger card
# (shown on desktop only, not iOS). Your transcription arrives as the routine's
# `context`, so write the routine to answer whatever it finds there.
MURMUR_SINK=cursor
MURMUR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/<routine-id>
MURMUR_WEBHOOK_TOKEN=crsr_<sender-key>

# Or point it at anything of your own — n8n, Shortcuts, your own server. That
# sink posts {"text", "source", "kind", "ts"} instead of {"context"}.
# MURMUR_SINK=webhook
# MURMUR_WEBHOOK_URL=https://example.com/hook
# MURMUR_WEBHOOK_TOKEN=        # sent as: Authorization: Bearer <token>

# Legacy: `grokbot` pushed straight into the desktop app's local gateway.
# Desktop app 0.36 and later encrypt ~/.grokbot/, so the gateway credentials
# can no longer be read and this sink only works on much older versions.
# MURMUR_SINK=grokbot
# MURMUR_AGENT=Assistant       # see your agents with: uv run murmur.py --agents

# --- Behaviour ---------------------------------------------------------------
# MURMUR_NOTES_DIR=~/Documents/voice-notes    # unset = notes are discarded
# MURMUR_ASR=local                            # or: groq, openai
# MURMUR_CLASSIFIER=auto                      # or: llm, heuristic
# MURMUR_PREFIX=[from voice memo]<space>
# MURMUR_MEMOS_DIR=                           # override auto-detection

# --- Model pinning (hosted model names get retired) --------------------------
# MURMUR_CHAT_MODEL=
# MURMUR_ASR_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# MURMUR_ASR_REMOTE_MODEL=
